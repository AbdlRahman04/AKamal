# Azure OpenAI (server-side only; never expose the API key to the browser)
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=YOUR_SERVER_ONLY_KEY
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Optional AI reliability and cost controls
LLM_DEFAULT_MAX_TOKENS=2048
LLM_DEFAULT_TEMPERATURE=0.3
LLM_MAX_RETRIES=4
LLM_BASE_DELAY_SECONDS=2
LLM_TIMEOUT_CONNECT_MS=10000
LLM_TIMEOUT_READ_MS=90000
# Empty means unlimited 429 retries; a number caps them.
LLM_MAX_429_RETRIES=4
LLM_MAX_429_BACKOFF_SECONDS=60
LLM_MAX_COMPLETION_TOKENS_PREFIXES=gpt-5,o1,o3,o4
IMAGE_MAX_PIXELS=4000000
IMAGE_JPEG_QUALITY=85
VISION_MAX_TOKENS=1024
MAX_COLLECTION_IMAGES=12

# Optional prompt/log locations
# PROMPTS_DIR=C:/absolute/path/to/prompts
# USAGE_LOG_PATH=C:/absolute/path/to/logs/llm_usage.jsonl
